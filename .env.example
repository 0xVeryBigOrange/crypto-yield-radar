# Copy to .env for local development. Never commit real secrets.

# Required
DATABASE_URL=postgres://keymint:keymint@localhost:5432/keymint

# Required in production. Render can generate this.
SESSION_SECRET=replace-with-a-long-random-string

# Required for /v1/chat/completions and the daily price refresh.
# Create one at https://openrouter.ai/keys
UPSTREAM_API_KEY=

# Optional admin UI. Requests to /api/admin fail closed when this is empty.
ADMIN_TOKEN=

# Protects POST /internal/daily. Leave empty to disable the endpoint.
# On Render this is generated. Copy the same value into the GitHub secret CRON_SECRET.
CRON_SECRET=

# Upstream. openai-compatible accepts any OpenAI-style base URL.
UPSTREAM_PROVIDER=openrouter
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
APP_PUBLIC_URL=http://localhost:3000
APP_NAME=Keymint

# Billing
MARKUP=1.3
RESERVE_BUFFER=1.25
DEFAULT_MAX_COMPLETION=1024
DEFAULT_RPM=60

# Deposits. Public RPCs work; replace them if you have a keyed endpoint.
MIN_DEPOSIT_USD=5
MIN_CONFIRMATIONS_ETH=12
MIN_CONFIRMATIONS_BSC=15
ETH_RPC_URL=https://ethereum.publicnode.com
BSC_RPC_URL=https://bsc.publicnode.com

# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
CORS_ORIGINS=*
UPSTREAM_TIMEOUT_MS=120000
